#!/usr/bin/env python3
"""Launch the tool implementation stored beside this executable."""

import sys
from pathlib import Path


def main():
    tool_directory = Path(__file__).resolve().with_name("@@TOOL_NAME@@.tool")
    sys.path.insert(0, str(tool_directory))
    from main import main as run_tool

    return run_tool()


if __name__ == "__main__":
    raise SystemExit(main())
